{
  "name": "Librocasion",
  "version": "1.0.0",
  "private": false,
  "description": "Aplicación web literaria",
  "scripts": {
    "parcel:serve": "parcel -p 8123 --target web",
    "parcel:build": "parcel build --target web --no-source-maps --no-cache",
    "clean": "rimraf dist .cache .cache-loader .parcel-cache",
    "dev": "npm-run-all clean prettier stylelint parcel:serve",
    "build": "npm-run-all clean prettier stylelint parcel:build",
    "test": "echo 'Everything is working as expected ✅\nStart working on your project by running \\033[1mnpm run dev\\033[0m'",
    "stylelint": "stylelint src/**/*.scss",
    "prettier": "prettier --check \"src/**/*.{html,js,json,md,scss}\""
  },
  "targets": {
    "web": {
      "context": "browser",
      "publicUrl": "./",
      "source": "src/index.html",
      "engines": {
        "browsers": "last 2 versions, > 0.5%, not dead"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmanasb10/libro_ocasion.git"
  },
  "author": {
    "name": "Rodrigo Mañas Barceló",
    "email": "rmanasb@uoc.edu"
  },
  "homepage": "https://github.com/rmanasb10/libro_ocasion.git#readme",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "@splidejs/splide": "^4.1.4",
    "autoprefixer": "^10.5.5",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "postcss-preset-env": "^11.5.1",
    "posthtml-include": "^2.0.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-scss": "^7.3.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1"
  }
}
